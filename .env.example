# -----------------------------------------------------------------------------
# RideSetu — Environment Variables Template (Controlled Pilot / Development)
# NOTE: Copy this file to .env.local and fill in your development/sandbox values.
# NEVER commit actual production secrets or credentials to source control.
# -----------------------------------------------------------------------------

# Database Configuration (MongoDB Atlas Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ridesetu?retryWrites=true&w=majority

# Authentication & Encryption Secrets
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
ENCRYPTION_KEY=your_aes_256_gcm_hex_or_base64_encryption_key_32_bytes

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Google Maps API Key (Native location engine functions with built-in fallbacks if omitted)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Payment Provider Configuration (MOCK or RAZORPAY_SANDBOX for test mode)
PAYMENT_PROVIDER=MOCK
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Payout Provider Configuration (Always MOCK for safety in testing/pilot)
PAYOUT_PROVIDER=MOCK

# Notification Provider Configuration (Always MOCK for development/pilot)
NOTIFICATION_PROVIDER=MOCK

# Optional Cloud Storage & Communications (Mock fallbacks active if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SENDGRID_API_KEY=
TWILIO_AUTH_TOKEN=
WHATSAPP_API_TOKEN=
