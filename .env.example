# -----------------------------------------------------------------------------
# RideSetu — Production Environment Variables Template
# Copy this file to .env.local for development or configure variables in your Vercel deployment console.
# NEVER commit production secrets, passwords, or private keys to source control.
# -----------------------------------------------------------------------------

# Database Configuration (MongoDB Atlas Production Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ridesetu?retryWrites=true&w=majority

# Authentication & Encryption Secrets
JWT_SECRET=your_production_jwt_secret_min_32_characters
ENCRYPTION_KEY=your_aes_256_gcm_hex_encryption_key_32_bytes

# Application URL
NEXT_PUBLIC_APP_URL=https://ridesetu.com

# Google Maps Platform Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_public_browser_google_maps_api_key
GOOGLE_MAPS_SERVER_API_KEY=your_private_server_google_maps_api_key

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://ridesetu.com/api/auth/google/callback

# Payment Gateway Configuration (MOCK or RAZORPAY_PRODUCTION)
PAYMENT_PROVIDER=RAZORPAY_SANDBOX
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Payout Provider Configuration (MOCK or RAZORPAY_X)
PAYOUT_PROVIDER=MOCK

# Notification Provider Configuration
NOTIFICATION_PROVIDER=MOCK
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=noreply@ridesetu.com

# Telemetry Throttling Bounds
LOCATION_UPDATE_MIN_DISTANCE_METERS=20
LOCATION_UPDATE_MIN_INTERVAL_MS=5000
